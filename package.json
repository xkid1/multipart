{
  "name": "@xkid1/multipart",
  "version": "0.2.0",
  "description": "Form body parser middleware for Node.js in pure TypeScript.",
  "keywords": [
    "formbodyparser",
    "form",
    "body",
    "parser",
    "middleware",
    "typescript"
  ],
  "homepage": "https://github.com/xkid1/multipart#readme",
  "bugs": "https://github.com/xkid1/multipart/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkid1/multipart.git"
  },
  "license": "MIT",
  "author": "xkid1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "tsd": {
    "directory": "./global.d.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./middleware/express": {
      "types": "./dist/middleware/express/index.d.ts",
      "import": "./dist/middleware/express/index.js",
      "default": "./dist/middleware/express/index.js"
    },
    "./middleware/nestjs": {
      "types": "./dist/middleware/nestjs/index.d.ts",
      "import": "./dist/middleware/nestjs/index.js",
      "default": "./dist/middleware/nestjs/index.js"
    },
    "./storage/local": {
      "types": "./dist/storage/local/index.d.ts",
      "import": "./dist/storage/local/index.js",
      "default": "./dist/storage/local/index.js"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3/index.d.ts",
      "import": "./dist/storage/s3/index.js",
      "default": "./dist/storage/s3/index.js"
    },
    "./storage/azure": {
      "types": "./dist/storage/azure/index.d.ts",
      "import": "./dist/storage/azure/index.js",
      "default": "./dist/storage/azure/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "yarn@4.18.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "yarn clean && yarn build:js && yarn build:types",
    "build:js": "swc src -d dist --strip-leading-paths --ignore \"**/*.test.ts\" \"**/*.spec.ts\"",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn coverage && yarn build",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
